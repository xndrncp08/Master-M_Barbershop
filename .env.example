# Public origin used for canonical URLs, sitemap, robots and JSON-LD.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: real Google rating, shown on the OpenGraph card only when both are set.
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=

# Optional: webhook (Zapier, Make, Slack, etc.) that receives every new booking as JSON.
BOOKING_WEBHOOK_URL=
